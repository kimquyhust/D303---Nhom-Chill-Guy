# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The MODEL NAME is declared in SOURCE CODE (src/config.py: DEFAULT_MODEL) and
# recorded in logging/metadata.json — NOT here (lab rule: model name goes in code
# for grading, not in .env). Only endpoint / secret values belong in this file.

# Provider: deterministic | ollama | openai
LLM_PROVIDER=openai

# Endpoint (no secret): Groq is OpenAI-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1

# Secret only — paste your key here in the real .env (never commit it)
LLM_API_KEY=your_secret_key_here

# For a local Ollama run instead:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434

# Optional behaviour flags
POLICY_GUARDRAIL=1
LLM_ANNOTATE=0
